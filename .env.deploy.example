# Copiar a .env.deploy (gitignored) — credenciales del operador Coolify.
# HTTPS por defecto; HTTP público requiere el opt-in explícito de esta máquina.
COOLIFY_URL=https://coolify.example.com
COOLIFY_API_TOKEN=your_api_token_here
# Si el panel disponible usa HTTP público y autorizas esa conexión en esta máquina:
# COOLIFY_URL=http://142.44.211.73:8000
# COOLIFY_ALLOW_INSECURE_HTTP=true
